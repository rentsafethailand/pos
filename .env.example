# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl

# Database URL (Optional - for direct access)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Payment Gateway (Omise / Stripe)
OMISE_PUBLIC_KEY=your-omise-public-key
OMISE_SECRET_KEY=your-omise-secret-key

# Email Service (Optional - for SendGrid/Resend)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourapp.com

# SMS Service (Optional)
SMS_API_KEY=your-sms-api-key

# App Configuration
NEXT_PUBLIC_APP_NAME=Car Rental Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000
